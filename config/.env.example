# ========================================
# Porter Analytics Agent - Configuration
# ========================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control!

# ========================================
# Gmail Account Configuration
# ========================================
# Your Gmail address where Porter data is received
EMAIL_ADDRESS=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-16-char-app-password

# Gmail IMAP/SMTP Settings (don't change these for Gmail)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ========================================
# Email Filtering
# ========================================
# Email address that sends Porter data
EMAIL_SENDER_FILTER=datainfra@theporter.in

# Subject line to look for (partial match)
EMAIL_SUBJECT_FILTER=Porter

# Only process unread emails (true/false)
ONLY_UNREAD=true

# Mark emails as read after processing (true/false)
MARK_AS_READ=true

# ========================================
# Report Configuration
# ========================================
# Comma-separated list of email addresses to send reports to
REPORT_TO=manager@example.com,team@example.com

# Report sender name
REPORT_FROM_NAME=Porter Analytics Agent

# Report subject line
REPORT_SUBJECT=Daily Porter Driver Performance Report - {date}

# ========================================
# Analysis Configuration
# ========================================
# Minimum orders threshold for "active" drivers
MIN_ORDERS_THRESHOLD=5

# Idle hours warning threshold
IDLE_HOURS_WARNING=4

# Cancellation rate warning threshold (percentage)
CANCELLATION_RATE_WARNING=15

# ========================================
# Optional: Advanced Settings
# ========================================
# Number of days of historical data to keep
HISTORICAL_DAYS_TO_KEEP=30

# Enable debug logging (true/false)
DEBUG_MODE=false
